{
	"name": "notation-engine",
	"version": "0.1.0",
	"description": "A from-scratch, framework-agnostic music notation engraving and rendering engine: an editable score model plus a canvas renderer, built to replace OpenSheetMusicDisplay/VexFlow where instant, region-scoped re-render on edit matters. No UI framework dependency in the core; embeds into any web app.",
	"keywords": [
		"music",
		"notation",
		"musicxml",
		"engraving",
		"canvas",
		"smufl",
		"sheet-music",
		"score"
	],
	"homepage": "https://github.com/Maripirs/notation-engine#readme",
	"bugs": {
		"url": "https://github.com/Maripirs/notation-engine/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Maripirs/notation-engine.git"
	},
	"license": "MIT",
	"author": "Maria Paz Maluenda",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./examples": {
			"types": "./dist/examples.d.ts",
			"import": "./dist/examples.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
		"test": "vitest run",
		"bench": "vitest run --config vitest.bench.config.ts",
		"glyphs": "node scripts/extract-glyph-metrics.mjs",
		"check": "tsc --noEmit",
		"smoke": "node scripts/pack-smoke.mjs"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"canvas": "^3.2.3",
		"typescript": "^5.6.0",
		"vite": "^6.0.0",
		"vitest": "^2.1.0"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"esbuild@0.21.5": true,
		"canvas@3.2.3": true
	}
}
