{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"outDir": "dist"
	},
	"include": ["src"],
	// Tests and the benchmark live next to the code they cover, but they are not
	// part of the published surface and the benchmark pulls in Node-only types.
	"exclude": ["src/**/*.test.ts", "src/**/test-helpers.ts", "src/**/*.bench.ts"]
}
